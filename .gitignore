# Arxiu complet del xat antic.
# Pot contenir informacio sensible i no s'ha de penjar a cap repositori
# sense confirmacio explicita.
xat-original/

# Fitxers temporals de sistema/editor.
Thumbs.db
desktop.ini
~$*

# Configuracio local del SIF.
.env
.env.*
!.env.example
sif/var/

# Importacio Trello: no guardar credencials ni fitxers locals amb tokens.
00-control/trello-import/*.local.json
00-control/trello-import/*.secrets.json
00-control/trello-import/.env

# Fitxers de connexio antics amb credencials.
parametres-connexio*.php
parametres_connexio.php
codi-drive/**/parametres-connexio*.php
codi-drive/**/parametres_connexio.php

# Fonts locals d'auditoria: snapshots de produccio amb dades personals.
# Es consulten per comparar fluxos, pero no formen part del lliurable Git.
codi-drive/intranet-actual/
codi-drive/intranet-alumne-actual/
codi-drive/intranet-collaboradors/
codi-drive/old-intranet/
codi-drive/web-actual/

# Artefactes temporals generats durant les revisions locals.
.codex-temp/
