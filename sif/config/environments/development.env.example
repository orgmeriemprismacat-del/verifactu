# Reference only. Do not store real secrets in Git.
# Configure these values in the hosting/runtime environment for https://pay-dev.prisma.cat
# This file is NOT loaded automatically by sif/config/sif.php.

SIF_ENV=development

# SIF database
SIF_DB_DSN=mysql:host=<mysql-host>;dbname=sif_dev;charset=utf8mb4
SIF_DB_USER=<development-db-user>
SIF_DB_PASSWORD=<secret>

# Legacy web database
SIF_LEGACY_DB_DSN=mysql:host=<legacy-web-host>;dbname=<legacy-web-db>;charset=utf8mb4
SIF_LEGACY_DB_USER=<legacy-web-user>
SIF_LEGACY_DB_PASSWORD=<secret>

# Legacy intranet database
SIF_LEGACY_INTRANET_DB_DSN=mysql:host=<legacy-intranet-host>;dbname=<legacy-intranet-db>;charset=utf8mb4
SIF_LEGACY_INTRANET_DB_USER=<legacy-intranet-user>
SIF_LEGACY_INTRANET_DB_PASSWORD=<secret>

# Issuer / series
SIF_ISSUER_NIF=<issuer-nif>
SIF_ISSUER_NAME=<issuer-name>
SIF_SERIES_INVOICE=A
SIF_SERIES_RECTIFICATION=R

# Internal HMAC API
SIF_INTERNAL_API_KEY_ID=<development-key-id>
SIF_INTERNAL_API_SECRET=<independent-secret>
SIF_INTERNAL_API_MAX_SKEW=300

# Private documents (must stay outside public/)
SIF_DOCUMENT_ROOT=<absolute-private-document-path>
SIF_DOCUMENT_MAX_BYTES=20971520

# Panel session isolation
SIF_PANEL_SESSION_NAME=SIFDEVSESSID

# Redsys — use credentials appropriate to this environment
SIF_REDSYS_MERCHANT_KEY=<secret>
SIF_REDSYS_MERCHANT_CODE=<merchant-code>
SIF_REDSYS_INTENT_CREATE_ROLES=<comma-separated-roles>

# AEAT — endpoint/certificate must match this environment
SIF_AEAT_WSDL=<environment-wsdl>
SIF_AEAT_ENDPOINT=<environment-endpoint>
SIF_AEAT_XSD_PATH=<absolute-xsd-path>
SIF_AEAT_CERT_PATH=<absolute-private-certificate-path>
SIF_AEAT_CERT_PASSWORD=<secret>
SIF_AEAT_SYSTEM_NAME=<system-name>
SIF_AEAT_SYSTEM_ID=<system-id>
SIF_AEAT_SYSTEM_VERSION=<version>
SIF_AEAT_INSTALLATION_ID=<installation-id>
