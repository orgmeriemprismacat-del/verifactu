Options +FollowSymlinks
RewriteEngine on
errorDocument 404 /pagina.php

Order Allow,Deny
Allow from all
Deny from 91.192.110.79

<IfModule mod_rewrite.c>
RewriteCond %{HTTP_HOST} ^prisma.cat [NC]
RewriteRule ^(.*)$ /$1 [R=301,L]
</IfModule>

Redirect 302 /documents/test/med/kilman/kilman.php /403
Redirect 302 /documents/material/intel/test_midas.pdf /403

Redirect 301 /prova/web/informacio/daniel-gabarro.php /302
